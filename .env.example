# ==============================================================================
# DORO Party Server Environment Variables Template
# 이 파일을 .env 로 복사해 환경에 맞게 값을 설정하세요. 실제 값은 저장소에 올리지 않습니다.
# ==============================================================================

# 1. Database (PostgreSQL, 서비스 전용 DB)
DB_HOST=localhost
DB_PORT=25432
DB_NAME=service_party
DB_USER=doro_admin
DB_PASSWORD=change-me

# 2. DORO IAM / Guard
IAM_HOST=localhost
IAM_PORT=28080
GUARD_GRPC_HOST=localhost
GUARD_GRPC_PORT=9090
GUARD_HTTP_HOST=localhost
GUARD_HTTP_PORT=28081
DORO_GUARD_SERVICE_TOKEN=

# 3. MinIO (사진 저장, 비공개 버킷)
MINIO_ENDPOINT=http://localhost:9000
# 운영에서는 루트 계정이 아니라 이 서비스 버킷만 쓰는 전용 계정(party_media)의 키를 .env 에 둔다.
MINIO_ACCESS_KEY=doro_admin
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=doro-party-media

# 4. 로그인 (Doro OAuth). 로그인·세션은 별도 BFF(doro-bff)가 하고 게이트웨이가 Bearer 를 붙여 준다.
# 이 서비스는 이 클라이언트(cid)로 발급된 토큰만 받는다.
PARTY_OAUTH_CLIENT_ID=doro-party
# 웹이 마운트된 하위 경로(알림 링크 등에 쓴다)
PARTY_WEB_BASE_PATH=/party
# 친구·모임 초대 코드 암호화 키(base64 32바이트): openssl rand -base64 32
# 이름은 예전 로그인 세션 키 그대로다. 저장된 초대 코드가 이 키로 암호화되므로 한 번 정하면 바꾸지 않는다.
PARTY_SESSION_KEY=change-me
# 선택: 초대 코드 키를 따로 두려면(없으면 PARTY_SESSION_KEY 를 쓴다)
# PARTY_INVITE_KEY=

# 5. Frontend
# 카카오맵 JavaScript 키(도메인 제한이 걸린 공개용 키)
VITE_KAKAO_MAP_APP_KEY=change-me

# 웹 푸시(알림). 비워 두면 푸시만 꺼진다. 키 쌍 만들기: scripts/setup-push-server.sh (개인 키는 절대 저장소에 두지 않는다)
PARTY_VAPID_PUBLIC_KEY=
PARTY_VAPID_PRIVATE_KEY=
PARTY_VAPID_SUBJECT=mailto:you@example.com
